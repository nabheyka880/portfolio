---
import { Image } from "astro:assets"

import SectionCustom from "../components/SectionCustom.astro"
import Layout from "../layouts/Layout.astro"
import CreditsText from "../components/CreditsBottom.astro"

import "../styles/global.css"
import "../styles/index.css"

import dayjs from "dayjs"

import botFirst from "../assets/images/1_bot.png"
import botSecond from "../assets/images/2_bot.png"

import maxe from "../assets/images/renders/maxe.png"
import maxe2 from "../assets/images/renders/Maxe2.png"

const now = dayjs()
const firstGame = dayjs("2023-07-14")
const diff = now.diff(firstGame, "year")
---

<Layout title="work">
    <SectionCustom title="hello there!!">
        <p>i'm Nab, i'm 15, and i simply like to code!!!</p>
        <p>i've coded in Roblox Studio for a while and i've made my first game around {diff} years ago!</p>
    </SectionCustom>

    <SectionCustom title="current projects">
        <ul>
            <li><a href="https://www.roblox.com/games/112411984130224/RECODE-Mikes-World">Mike's World</a> - it would mean a lot if you checked it out!!</li>
            <li>Fractured Genesis</li>
            <li>Out of Space</li>
        </ul>
    </SectionCustom>

    <SectionCustom title="other projects or sum 🎉🎉🎉">
        <p>some of these projects are not open source cause i don't feel safe open sourcing them, sorry..</p>
        <ul>
            <li><a href="https://github.com/nabheyka880/Roblox-Moderation-Application">Roblox Moderation Application</a> - moderation Windows app for Roblox (lowk shit)</li>
            <li><a href="https://github.com/nabheyka880/UBG-Discord-BOT">UBG Discord bot</a> - a Discord bot for a discontinued game of mine (kinda old)</li>
            <li><a href="https://github.com/nabheyka880/portfolio">this website like right here! (still new to making websites)</a></li>
            <li>All Purpose Discord Bot <i>(aka evil fucking bunny)</i> - a Discord bot for all purposes that i made on my own</li>
            <div class="bot-images">
                <!-- <img alt="bot's profile" src="/images/1_bot.PNG"/>
                <img alt="bot's help command" src="/images/2_bot.PNG"/> -->
                <Image src={botFirst} alt="bot number 1"/>
                <Image src={botSecond} alt="bot number 2"/>
            </div>
        </ul>
    </SectionCustom>

    <SectionCustom title="video work">
        <p>here's some of videos of mine that show my work, enjoy!!</p>
        <div class="videos">
            <video controls muted src="/videos/knight.mp4"/>
            <video controls muted src="/videos/jarona.mp4"/>
            <video controls muted src="/videos/om-lines.mp4"/>
            <video controls muted src="/videos/settings.mp4"/>
            <video controls muted src="/videos/tbb-r.mp4"/>
        </div>
    </SectionCustom>

    <SectionCustom title="renders i made for fun!!">
        <p>DISCLAIMER: these are renders i make for FUN, i'm not specialized in rendering but i just wanted to put it here cause why not</p>
        <div class="renders">
            <!-- <img src="/images/renders/Maxe2.png"/>
            <img src="/images/renders/maxe.png"/> -->
            <Image height=400 src={maxe} alt="sustingus"/>
            <Image height=400 src={maxe2} alt="sustingus2"/>
        </div>
    </SectionCustom>
    <CreditsText/>
</Layout>